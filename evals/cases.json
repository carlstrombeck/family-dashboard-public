{
  "context": {
    "now": "2026-10-14T10:00:00",
    "timezone": "Europe/Stockholm",
    "lists": [{"id": "shopping", "title": "Inköpslista"}, {"id": "todo", "title": "Att göra"}],
    "calendars": [{"id": "family", "name": "Familj"}, {"id": "kids", "name": "Barn"}],
    "people": {"alex": "Alex", "sam": "Sam"},
    "aliases": ["aska"]
  },
  "cases": [
    {"id": "list-two-items", "tags": ["list"], "text": "ASCA lägg till mjölk och bröd i inköpslistan",
     "expect": {"actions": [{"type": "list_items", "list_id": "shopping", "item_keywords": ["mjölk", "bröd"], "item_count": 2}]}},
    {"id": "list-wake-word-misheard", "tags": ["list", "speech"], "text": "aska handla kaffe",
     "expect": {"actions": [{"type": "list_items", "list_id": "shopping", "item_keywords": ["kaffe"], "item_count": 1}]}},
    {"id": "list-misspelled-item", "tags": ["list", "speech"], "text": "lägg till mjök på inköpslistan",
     "expect": {"actions": [{"type": "list_items", "list_id": "shopping", "item_keywords": ["mjölk"], "item_count": 1}]}},
    {"id": "list-three-items", "tags": ["list"], "text": "lägg till ägg smör och ost i inköpslistan",
     "expect": {"actions": [{"type": "list_items", "list_id": "shopping", "item_keywords": ["ägg", "smör", "ost"], "item_count": 3}]}},
    {"id": "list-todo", "tags": ["list"], "text": "lägg till ring tandläkaren på att göra listan",
     "expect": {"actions": [{"type": "list_items", "list_id": "todo", "item_keywords": ["tandläk"], "item_count": 1}]}},
    {"id": "list-english", "tags": ["list", "english"], "text": "add bananas to the shopping list",
     "expect": {"actions": [{"type": "list_items", "list_id": "shopping", "item_keywords": ["banan"], "item_count": 1}]}},

    {"id": "event-weekday-time", "tags": ["event", "dates"], "text": "lägg in tandläkaren på fredag klockan nio",
     "expect": {"actions": [{"type": "event", "calendar": "family", "allDay": false, "title_keywords": ["tandläk"],
                             "start": "2026-10-16T09:00:00+02:00", "end": "2026-10-16T10:00:00+02:00"}]}},
    {"id": "event-two-day-all-day", "tags": ["event", "dates"], "text": "lägg in konferens 3-4 november",
     "expect": {"actions": [{"type": "event", "allDay": true, "title_keywords": ["konferens"],
                             "start": "2026-11-03", "end": "2026-11-04"}]}},
    {"id": "event-named-calendar", "tags": ["event"], "text": "imorgon simskola klockan 17 till 18 i barnkalendern",
     "expect": {"actions": [{"type": "event", "calendar": "kids", "allDay": false, "title_keywords": ["sim"],
                             "start": "2026-10-15T17:00:00+02:00", "end": "2026-10-15T18:00:00+02:00"}]}},
    {"id": "event-all-day-weekday", "tags": ["event", "dates"], "text": "lägg in middag med farmor på lördag",
     "expect": {"actions": [{"type": "event", "calendar": "family", "allDay": true, "title_keywords": ["farmor"],
                             "start": "2026-10-17", "end": "2026-10-17"}]}},
    {"id": "event-past-midnight", "tags": ["event", "dates"], "text": "fest på fredag 22 till 01",
     "expect": {"actions": [{"type": "event", "allDay": false, "title_keywords": ["fest"],
                             "start": "2026-10-16T22:00:00+02:00", "end": "2026-10-17T01:00:00+02:00"}]}},
    {"id": "event-next-week", "tags": ["event", "dates"], "text": "möte nästa måndag klockan 8",
     "expect": {"actions": [{"type": "event", "allDay": false, "title_keywords": ["möte"],
                             "start": "2026-10-19T08:00:00+02:00", "end": "2026-10-19T09:00:00+02:00"}]}},
    {"id": "event-after-dst", "tags": ["event", "dates"], "text": "lägg in flytt den 26 oktober klockan 10",
     "expect": {"actions": [{"type": "event", "allDay": false, "title_keywords": ["flytt"],
                             "start": "2026-10-26T10:00:00+01:00", "end": "2026-10-26T11:00:00+01:00"}]}},
    {"id": "event-date-without-year", "tags": ["event", "dates"], "text": "lägg in nationaldagen 6 juni",
     "expect": {"actions": [{"type": "event", "allDay": true, "title_keywords": ["nationaldag"],
                             "start": "2027-06-06", "end": "2027-06-06"}]}},
    {"id": "event-location", "tags": ["event"], "text": "kalas på Kungsholmen på söndag klockan 14",
     "expect": {"actions": [{"type": "event", "allDay": false, "title_keywords": ["kalas"], "location_keywords": ["kungsholmen"],
                             "start": "2026-10-18T14:00:00+02:00", "end": "2026-10-18T15:00:00+02:00"}]}},

    {"id": "expense-thousands-spaced", "tags": ["expense"], "text": "Alex betalade elräkningen 1 250 kronor",
     "expect": {"actions": [{"type": "expense", "amount": 125000, "paid_by": "alex", "date": "2026-10-14", "category_any": ["home", "other"]}]}},
    {"id": "expense-travel", "tags": ["expense"], "text": "Sam betalade 12 000 för flygbiljetter",
     "expect": {"actions": [{"type": "expense", "amount": 1200000, "paid_by": "sam", "date": "2026-10-14", "category_any": ["travel"]}]}},
    {"id": "expense-yesterday", "tags": ["expense", "dates"], "text": "Alex betalade tandläkaren 900 kronor igår",
     "expect": {"actions": [{"type": "expense", "amount": 90000, "paid_by": "alex", "date": "2026-10-13"}]}},
    {"id": "expense-no-payer", "tags": ["expense", "unclear"], "text": "lägg till utgift 300 kronor för pizza",
     "expect": {"reply": true}},

    {"id": "weather-tomorrow", "tags": ["weather"], "text": "hur blir vädret imorgon",
     "expect": {"actions": [{"type": "weather", "day": "tomorrow"}]}},
    {"id": "weather-jacket", "tags": ["weather"], "text": "behöver jag jacka idag",
     "expect": {"actions": [{"type": "weather", "day": "today"}]}},
    {"id": "weather-unknown-day", "tags": ["weather"], "text": "blir det regn på lördag",
     "expect": {"actions": [{"type": "answer", "max_chars": 300}]}},

    {"id": "undo-spoken", "tags": ["undo"], "text": "nej det blev fel ta bort det jag nyss la till",
     "expect": {"actions": [{"type": "undo"}]}},

    {"id": "answer-fact", "tags": ["answer"], "text": "hur länge kokar man ett ägg",
     "expect": {"actions": [{"type": "answer", "max_chars": 400, "must_contain_any": ["minut"], "spoken_max_sentences": 3}]}},
    {"id": "answer-recipe", "tags": ["answer"], "text": "hur gör man pannkakor",
     "expect": {"actions": [{"type": "answer", "max_chars": 900, "max_bullets": 8, "max_steps": 5,
                             "must_contain_any": ["mjöl"], "spoken_contains": "receptet står på skärmen"}]}},
    {"id": "answer-translate", "tags": ["answer", "english"], "text": "vad heter ekorre på engelska",
     "expect": {"actions": [{"type": "answer", "max_chars": 300, "must_contain_any": ["squirrel"]}]}},

    {"id": "multi-list-and-event", "tags": ["multi"], "text": "lägg till blöjor i inköpslistan och lägg in föräldramöte på torsdag klockan 18",
     "expect": {"actions": [
       {"type": "list_items", "list_id": "shopping", "item_keywords": ["blöj"], "item_count": 1},
       {"type": "event", "allDay": false, "title_keywords": ["föräldramöte"],
        "start": "2026-10-15T18:00:00+02:00", "end": "2026-10-15T19:00:00+02:00"}]}},

    {"id": "unclear-half-command", "tags": ["unclear"], "text": "lägg till",
     "expect": {"reply": true}},
    {"id": "unclear-wake-word-only", "tags": ["unclear", "speech"], "text": "ASCA",
     "expect": {"reply": true}}
  ]
}
