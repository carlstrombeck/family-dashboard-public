# Docker: copy to .env and fill in. Vercel: add the same variables under the project's
# Settings -> Environment Variables.

# Google accounts that may sign in as admins (comma-separated). More people can be added to the
# dashboard_members table in Supabase. Sign-in uses the Google OAuth client below.
DASHBOARD_ADMINS=
# Optional: key for signing session cookies. Default: derived from GOOGLE_CLIENT_SECRET.
SESSION_SECRET=

# Optional shared admin password, for installs without Google sign-in (e.g. Docker on a LAN).
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_ACCESS_KEY=

# Shown in the top-right corner, e.g. "The Smiths".
DASHBOARD_TITLE=
# en or sv. Empty = follow the iPad's language.
DASHBOARD_LANGUAGE=

# Show sample data instead of your accounts (try the layout before setting anything up).
DEMO_MODE=false

# --- Token storage: Supabase (required on Vercel; README: "Deploy on Vercel + Supabase") ---
# Unset = a local folder (DATA_DIR), which is what the Docker setup uses.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Google Calendar + Gmail (README: "1. Google Calendar and Gmail") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client. Default on Vercel:
# https://<production domain>/auth/google/callback; otherwise the localhost address below.
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Calendars to show, comma-separated, by name or ID. "Name=Short name" renames one.
# Empty = the calendars ticked in Google Calendar. /setup lists them all.
CALENDARS=

# --- Google Keep (README: "2. Google Keep") ---
KEEP_EMAIL=
KEEP_MASTER_TOKEN=
# Which Keep notes to show: family (shared with your Google family group), shared (with anyone),
# or note titles, comma-separated (case and punctuation don't matter).
KEEP_LISTS=family

# --- Points & balances ---
# EuroBonus points from SAS's emails in the connected Gmail.
SHOW_EUROBONUS=true
# Weather (Open-Meteo, no key needed). Leave empty to hide.
WEATHER_LAT=
WEATHER_LON=
WEATHER_PLACE=

# --- Voice commands (README: "Voice commands") ---
# An API key from platform.claude.com turns on the mic. Leave empty to hide it.
ANTHROPIC_API_KEY=
# The wake word, and how Swedish speech recognition tends to mishear it (comma-separated).
# With the default name ASCA, its usual mishearings are built in.
ASSISTANT_NAME=ASCA
ASSISTANT_ALIASES=

# --- Split (optional companion app for two people sharing costs; README: "Split") ---
# Split's two person ids and the names to show, first person first. Empty: no Split balance.
SPLIT_PEOPLE=
# The column in Split's split_entries table that holds the first person's share (parts per million).
SPLIT_RATIO_COLUMN=first_ratio_ppm
# A "Family finances" link in the balances panel. Empty: no link.
FINANCES_URL=
